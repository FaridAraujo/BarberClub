# ─── Barber Club — Environment Variables ───────────────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All others are server-only.
# ────────────────────────────────────────────────────────────────────────────────

# ── Analytics (optional) ────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Contact / WhatsApp ──────────────────────────────────────────────────────────
# Overrides the hardcoded WhatsApp number in lib/constants.ts
# NEXT_PUBLIC_WHATSAPP_NUMBER=50600000000

# ── Social ──────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/barber_club__

# ── Maps ────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_MAPS_QUERY=9.9906133,-84.1351361
